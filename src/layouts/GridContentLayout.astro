---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";
import "../styles/grid-layout.css";

interface Props {
    title?: string;
    activeSlug?: string;
    background?: string;
}

const { title = "Shabtai Pinchevsky", activeSlug, background } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allPosts = (await getCollection("posts")).sort((a, b) => b.data.year - a.data.year);
const currentPath = Astro.url.pathname.replace(/\/$/, "");

const thumbUrls = new Map<string, string>();
for (const post of allPosts) {
    const src = post.data.icon ?? post.data.hero;
    if (src && post.data.slug) {
        const img = await getImage({ src, width: 800, quality: 80 });
        thumbUrls.set(post.data.slug, img.src);
    }
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <Font cssVariable="--font-body" preload />
        <Font cssVariable="--font-heading" preload />
        <ClientRouter />
    </head>
    <body data-base={base} data-page={activeSlug ? "content" : "home"} style={background ? `--color-bg: ${background}; --color-sidebar-bg: ${background};` : ''}>
        <div class="grid-content-layout">
            <aside class="content-nav" transition:persist>
                <header class="grid-header">
                    <a href={`${base}/`} class="artist-name">Shabtai Pinchevsky</a>
                </header>
                <nav class="col-scroll">
                    <div class="nav-thumb-grid">
                        {allPosts.filter(p => p.data.slug).map((item) => {
                            const thumb = thumbUrls.get(item.data.slug!);
                            return (
                                <a
                                    href={`${base}/${item.data.slug}`}
                                    class:list={["project-grid-item", { active: currentPath === `${base}/${item.data.slug}` }]}
                                    data-slug={item.data.slug}
                                    data-thumb={thumb ?? undefined}
                                    data-summary={item.data.summary ?? undefined}
                                >
                                    {thumb
                                        ? <img src={thumb} class="nav-thumb" alt={item.data.title} />
                                        : <div class="grid-placeholder"></div>
                                    }
                                    <div class="project-grid-label">{item.data.title}</div>
                                </a>
                            );
                        })}
                    </div>
                </nav>
            </aside>
            <main class="content-panel" transition:name="content-panel" data-bg={background ?? ''}>
                <slot />
            </main>
            <div class="lightbox" id="lightbox">
                <button class="lightbox-close" aria-label="Close">&times;</button>
                <button class="lightbox-prev" aria-label="Previous">&lsaquo;</button>
                <button class="lightbox-next" aria-label="Next">&rsaquo;</button>
                <img src="" alt="" />
                <div class="lightbox-video"><iframe src="" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
                <div class="lightbox-caption"></div>
            </div>
        </div>
        <script>
            function initGridLightbox() {
                const lightbox = document.getElementById("lightbox");
                if (!lightbox) return;
                const lbImg = lightbox.querySelector(":scope > img") as HTMLImageElement;
                const lbVideo = lightbox.querySelector(".lightbox-video") as HTMLElement;
                const lbIframe = lbVideo.querySelector("iframe") as HTMLIFrameElement;
                const lbCaption = lightbox.querySelector(".lightbox-caption") as HTMLElement;
                const btnClose = lightbox.querySelector(".lightbox-close") as HTMLElement;
                const btnPrev = lightbox.querySelector(".lightbox-prev") as HTMLElement;
                const btnNext = lightbox.querySelector(".lightbox-next") as HTMLElement;

                let items: HTMLElement[] = [];
                let currentIndex = 0;
                let mode: "recent" | "figures" = "recent";

                function collectRecent() {
                    mode = "recent";
                    items = Array.from(document.querySelectorAll(".recent-media"));
                }

                function collectFigures() {
                    mode = "figures";
                    items = Array.from(document.querySelectorAll(".project-content figure"));
                }

                function show(index: number) {
                    if (items.length === 0) return;
                    currentIndex = ((index % items.length) + items.length) % items.length;
                    const el = items[currentIndex];

                    if (mode === "recent") {
                        const type = el.dataset.type;
                        const src = el.dataset.src || "";
                        const caption = el.dataset.caption || "";

                        if (type === "video") {
                            lbImg.style.display = "none";
                            lbVideo.style.display = "block";
                            lbIframe.src = src + "?autoplay=1&controls=0";
                        } else {
                            lbVideo.style.display = "none";
                            lbIframe.src = "";
                            lbImg.style.display = "";
                            lbImg.src = src;
                            lbImg.alt = caption;
                        }
                        lbCaption.textContent = caption;
                    } else {
                        const img = el.querySelector("img");
                        if (!img) return;
                        lbVideo.style.display = "none";
                        lbIframe.src = "";
                        lbImg.style.display = "";
                        lbImg.src = img.src;
                        lbImg.alt = img.alt;

                        let captionText = el.querySelector(".caption")?.textContent || "";
                        if (!captionText) {
                            const gallery = el.closest(".gallery");
                            captionText = gallery?.querySelector(":scope > .caption")?.textContent || "";
                        }
                        lbCaption.textContent = captionText;
                    }

                    lightbox.classList.add("active");
                    btnPrev.style.display = items.length > 1 ? "" : "none";
                    btnNext.style.display = items.length > 1 ? "" : "none";
                }

                function close() {
                    lightbox.classList.remove("active");
                    lbIframe.src = "";
                }

                document.addEventListener("click", (e) => {
                    const btn = (e.target as HTMLElement).closest(".recent-media");
                    if (btn) {
                        collectRecent();
                        const idx = items.indexOf(btn as HTMLElement);
                        if (idx !== -1) show(idx);
                        return;
                    }
                    const fig = (e.target as HTMLElement).closest(".project-content figure");
                    if (fig) {
                        collectFigures();
                        const idx = items.indexOf(fig as HTMLElement);
                        if (idx !== -1) show(idx);
                    }
                });

                btnClose.addEventListener("click", close);
                btnPrev.addEventListener("click", (e) => { e.stopPropagation(); show(currentIndex - 1); });
                btnNext.addEventListener("click", (e) => { e.stopPropagation(); show(currentIndex + 1); });
                lightbox.addEventListener("click", (e) => {
                    if (e.target === lightbox || e.target === lbImg) close();
                });
                document.addEventListener("keydown", (e) => {
                    if (!lightbox.classList.contains("active")) return;
                    if (e.key === "Escape") close();
                    if (e.key === "ArrowLeft") show(currentIndex - 1);
                    if (e.key === "ArrowRight") show(currentIndex + 1);
                });
            }

            initGridLightbox();
            document.addEventListener("astro:after-swap", initGridLightbox);
        </script>

        <script>
            const base = document.body.dataset.base || "";
            let sidebarScrollTop = 0;
            let homeScrollTop = 0;
            let wasHomePage = false;

            function isHomePath(pathname: string) {
                const p = pathname.replace(/\/$/, "");
                return p === base || p === "";
            }

            document.addEventListener("astro:before-swap", () => {
                sidebarScrollTop = document.querySelector(".content-nav .col-scroll")?.scrollTop ?? 0;

                const onHome = isHomePath(window.location.pathname);
                wasHomePage = onHome;
                if (onHome) {
                    homeScrollTop = document.querySelector(".home-masonry-scroll")?.scrollTop ?? 0;
                }
            });

            function applyBackground() {
                const bg = document.querySelector(".content-panel")?.getAttribute("data-bg") || "";
                if (bg) {
                    document.body.style.setProperty("--color-bg", bg);
                    document.body.style.setProperty("--color-sidebar-bg", bg);
                } else {
                    document.body.style.removeProperty("--color-bg");
                    document.body.style.removeProperty("--color-sidebar-bg");
                }
            }

            document.addEventListener("astro:after-swap", () => {
                const sidebar = document.querySelector(".content-nav .col-scroll");
                if (sidebar) sidebar.scrollTop = sidebarScrollTop;

                applyBackground();

                const path = window.location.pathname.replace(/\/$/, "");
                document.querySelectorAll(".content-nav .project-grid-item").forEach((a) => {
                    const href = a.getAttribute("href")?.replace(/\/$/, "") || "";
                    a.classList.toggle("active", href === path);
                });

                const onHome = isHomePath(path);
                if (onHome && homeScrollTop > 0) {
                    const el = document.querySelector(".home-masonry-scroll");
                    if (el) el.scrollTop = homeScrollTop;
                } else if (!onHome) {
                    document.querySelector(".content-panel")?.scrollTo(0, 0);
                }
            });
        </script>

        <script>
            let homeHoverStop: (() => void) | null = null;

            function initHomeHover() {
                homeHoverStop?.();
                homeHoverStop = null;

                const displayImg = document.getElementById("home-display-img") as HTMLImageElement | null;
                if (!displayImg) return;

                const defaultSrc = displayImg.dataset.defaultSrc || displayImg.src;
                const bioOverlay = document.getElementById("home-bio-overlay") as HTMLElement | null;
                const labelEl = document.getElementById("home-display-label") as HTMLElement | null;
                const titleEl = labelEl?.querySelector(".home-display-title") as HTMLElement | null;
                const summaryEl = labelEl?.querySelector(".home-display-summary") as HTMLElement | null;

                const navItems = Array.from(
                    document.querySelectorAll<HTMLElement>(".content-nav .project-grid-item[data-thumb]")
                );

                function showDefault() {
                    displayImg.src = defaultSrc;
                    if (bioOverlay) bioOverlay.style.opacity = "1";
                    if (labelEl) labelEl.style.opacity = "0";
                }

                function showThumb(el: HTMLElement) {
                    displayImg.src = el.dataset.thumb!;
                    if (bioOverlay) bioOverlay.style.opacity = "0";
                    if (titleEl) titleEl.textContent = el.querySelector(".project-grid-label")?.textContent ?? "";
                    if (summaryEl) {
                        summaryEl.textContent = el.dataset.summary ?? "";
                        summaryEl.style.display = el.dataset.summary ? "" : "none";
                    }
                    if (labelEl) labelEl.style.opacity = "1";
                }

                const ctrl = new AbortController();
                const { signal } = ctrl;

                navItems.forEach((el) => {
                    el.addEventListener("mouseenter", () => showThumb(el), { signal });
                    el.addEventListener("mouseleave", showDefault, { signal });
                });

                homeHoverStop = () => ctrl.abort();
            }

            initHomeHover();
            document.addEventListener("astro:after-swap", initHomeHover);
        </script>

    </body>
</html>
