---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import ShortBio from "../components/ShortBio.astro";
import "../styles/global.css";
import "../styles/grid-layout.css";

interface Props {
    title?: string;
    activeSlug?: string;
    background?: string;
}

const { title = "Shabtai Pinchevsky", activeSlug, background } = Astro.props;

const NAV_SECTIONS = [
    { type: "ongoing", label: "Ongoing" },
    { type: "project", label: "Projects" },
    { type: "interactive", label: "Interactive" },
    { type: "other-work", label: "Other Works" },
    { type: "teaching-tool", label: "Teaching Tools" },
] as const;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allPosts = (await getCollection("posts")).sort((a, b) => b.data.year - a.data.year);
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <Font cssVariable="--font-body" preload />
        <Font cssVariable="--font-heading" preload />
        <ClientRouter />
    </head>
    <body data-base={base} style={background ? `--color-bg: ${background}; --color-sidebar-bg: ${background};` : ''}>
        <div class="grid-content-layout">
            <aside class="content-nav" transition:persist>
                <header class="grid-header">
                    <a href={`${base}/`} class="artist-name">Shabtai Pinchevsky</a>
                </header>
                <nav class="col-scroll">
                    <ShortBio />
                    {NAV_SECTIONS.map(({ type, label }) => {
                        const items = allPosts.filter((p) => p.data.type === type && p.data.slug);
                        if (items.length === 0) return null;
                        return (
                            <>
                                <h2 class="col-heading">{label}</h2>
                                {items.map((item) => {
                                    const navThumb = item.data.icon ?? item.data.hero;
                                    return (
                                        <a
                                            href={`${base}/${item.data.slug}`}
                                            class:list={["project-grid-item", { active: currentPath === `${base}/${item.data.slug}` }]}
                                            data-slug={item.data.slug}
                                        >
                                            {navThumb && <Image src={navThumb} alt="" class="nav-thumb" width={96} height={96} quality={90} loading="lazy" />}
                                            <div class="project-grid-label">{item.data.title}</div>
                                        </a>
                                    );
                                })}
                            </>
                        );
                    })}
                </nav>
            </aside>
            <main class="content-panel" transition:name="content-panel" data-bg={background ?? ''}>
                <slot />
            </main>
            <div class="lightbox" id="lightbox">
                <button class="lightbox-close" aria-label="Close">&times;</button>
                <button class="lightbox-prev" aria-label="Previous">&lsaquo;</button>
                <button class="lightbox-next" aria-label="Next">&rsaquo;</button>
                <img src="" alt="" />
                <div class="lightbox-video"><iframe src="" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
                <div class="lightbox-caption"></div>
            </div>
        </div>
        <svg id="connector-svg" aria-hidden="true">
            <path id="connector-path" d="" />
        </svg>

        <script>
            function initGridLightbox() {
                const lightbox = document.getElementById("lightbox");
                if (!lightbox) return;
                const lbImg = lightbox.querySelector(":scope > img") as HTMLImageElement;
                const lbVideo = lightbox.querySelector(".lightbox-video") as HTMLElement;
                const lbIframe = lbVideo.querySelector("iframe") as HTMLIFrameElement;
                const lbCaption = lightbox.querySelector(".lightbox-caption") as HTMLElement;
                const btnClose = lightbox.querySelector(".lightbox-close") as HTMLElement;
                const btnPrev = lightbox.querySelector(".lightbox-prev") as HTMLElement;
                const btnNext = lightbox.querySelector(".lightbox-next") as HTMLElement;

                let items: HTMLElement[] = [];
                let currentIndex = 0;
                let mode: "recent" | "figures" = "recent";

                function collectRecent() {
                    mode = "recent";
                    items = Array.from(document.querySelectorAll(".recent-media"));
                }

                function collectFigures() {
                    mode = "figures";
                    items = Array.from(document.querySelectorAll(".project-content figure"));
                }

                function show(index: number) {
                    if (items.length === 0) return;
                    currentIndex = ((index % items.length) + items.length) % items.length;
                    const el = items[currentIndex];

                    if (mode === "recent") {
                        const type = el.dataset.type;
                        const src = el.dataset.src || "";
                        const caption = el.dataset.caption || "";

                        if (type === "video") {
                            lbImg.style.display = "none";
                            lbVideo.style.display = "block";
                            lbIframe.src = src + "?autoplay=1&controls=0";
                        } else {
                            lbVideo.style.display = "none";
                            lbIframe.src = "";
                            lbImg.style.display = "";
                            lbImg.src = src;
                            lbImg.alt = caption;
                        }
                        lbCaption.textContent = caption;
                    } else {
                        const img = el.querySelector("img");
                        if (!img) return;
                        lbVideo.style.display = "none";
                        lbIframe.src = "";
                        lbImg.style.display = "";
                        lbImg.src = img.src;
                        lbImg.alt = img.alt;

                        let captionText = el.querySelector(".caption")?.textContent || "";
                        if (!captionText) {
                            const gallery = el.closest(".gallery");
                            captionText = gallery?.querySelector(":scope > .caption")?.textContent || "";
                        }
                        lbCaption.textContent = captionText;
                    }

                    lightbox.classList.add("active");
                    btnPrev.style.display = items.length > 1 ? "" : "none";
                    btnNext.style.display = items.length > 1 ? "" : "none";
                }

                function close() {
                    lightbox.classList.remove("active");
                    lbIframe.src = "";
                }

                document.addEventListener("click", (e) => {
                    const btn = (e.target as HTMLElement).closest(".recent-media");
                    if (btn) {
                        collectRecent();
                        const idx = items.indexOf(btn as HTMLElement);
                        if (idx !== -1) show(idx);
                        return;
                    }
                    const fig = (e.target as HTMLElement).closest(".project-content figure");
                    if (fig) {
                        collectFigures();
                        const idx = items.indexOf(fig as HTMLElement);
                        if (idx !== -1) show(idx);
                    }
                });

                btnClose.addEventListener("click", close);
                btnPrev.addEventListener("click", (e) => { e.stopPropagation(); show(currentIndex - 1); });
                btnNext.addEventListener("click", (e) => { e.stopPropagation(); show(currentIndex + 1); });
                lightbox.addEventListener("click", (e) => {
                    if (e.target === lightbox || e.target === lbImg) close();
                });
                document.addEventListener("keydown", (e) => {
                    if (!lightbox.classList.contains("active")) return;
                    if (e.key === "Escape") close();
                    if (e.key === "ArrowLeft") show(currentIndex - 1);
                    if (e.key === "ArrowRight") show(currentIndex + 1);
                });
            }

            initGridLightbox();
            document.addEventListener("astro:after-swap", initGridLightbox);
        </script>

        <script>
            const base = document.body.dataset.base || "";
            let sidebarScrollTop = 0;
            let homeScrollTop = 0;
            let wasHomePage = false;

            function isHomePath(pathname: string) {
                const p = pathname.replace(/\/$/, "");
                return p === base || p === "";
            }

            document.addEventListener("astro:before-swap", () => {
                sidebarScrollTop = document.querySelector(".content-nav .col-scroll")?.scrollTop ?? 0;

                const onHome = isHomePath(window.location.pathname);
                wasHomePage = onHome;
                if (onHome) {
                    homeScrollTop = document.querySelector(".home-masonry-scroll")?.scrollTop ?? 0;
                }
            });

            function applyBackground() {
                const bg = document.querySelector(".content-panel")?.getAttribute("data-bg") || "";
                if (bg) {
                    document.body.style.setProperty("--color-bg", bg);
                    document.body.style.setProperty("--color-sidebar-bg", bg);
                } else {
                    document.body.style.removeProperty("--color-bg");
                    document.body.style.removeProperty("--color-sidebar-bg");
                }
            }

            document.addEventListener("astro:after-swap", () => {
                const sidebar = document.querySelector(".content-nav .col-scroll");
                if (sidebar) sidebar.scrollTop = sidebarScrollTop;

                applyBackground();

                const path = window.location.pathname.replace(/\/$/, "");
                document.querySelectorAll(".content-nav .project-grid-item").forEach((a) => {
                    const href = a.getAttribute("href")?.replace(/\/$/, "") || "";
                    a.classList.toggle("active", href === path);
                });

                const onHome = isHomePath(path);
                if (onHome && homeScrollTop > 0) {
                    const el = document.querySelector(".home-masonry-scroll");
                    if (el) el.scrollTop = homeScrollTop;
                } else if (!onHome) {
                    document.querySelector(".content-panel")?.scrollTo(0, 0);
                }
            });
        </script>

        <script>
            function initMasonry() {
                const grid = document.querySelector(".home-masonry") as HTMLElement | null;
                if (!grid) return;

                const cs = getComputedStyle(grid);
                const rowGap = parseFloat(cs.rowGap) || 0;
                const rowSize = parseFloat(cs.gridAutoRows) || 10;

                function updateAll() {
                    const items = [...grid.querySelectorAll<HTMLElement>(".project-grid-item")];
                    // Give all items room to expand to natural height
                    items.forEach(item => { item.style.gridRowEnd = "span 1000"; });
                    // Force reflow so the browser computes natural heights
                    void grid.offsetHeight;
                    // Measure all, then set correct spans (batch reads before writes)
                    const heights = items.map(item => item.getBoundingClientRect().height);
                    items.forEach((item, i) => {
                        item.style.gridRowEnd = `span ${Math.max(1, Math.ceil((heights[i] + rowGap) / (rowSize + rowGap)))}`;
                    });
                }

                updateAll();

                grid.querySelectorAll("img").forEach(img => {
                    if (!img.complete) img.addEventListener("load", updateAll, { once: true });
                });

                let t: ReturnType<typeof setTimeout>;
                window.addEventListener("resize", () => { clearTimeout(t); t = setTimeout(updateAll, 100); });
            }

            initMasonry();
            document.addEventListener("astro:after-swap", initMasonry);
        </script>

        <script>
            let connectorAbort: AbortController | null = null;
            let animFrame: number | null = null;

            function smartScroll(scrollEl: Element, targetEl: Element) {
                const sRect = scrollEl.getBoundingClientRect();
                const tRect = targetEl.getBoundingClientRect();
                const relTop = tRect.top - sRect.top;
                const relBottom = tRect.bottom - sRect.top;
                const h = sRect.height;
                if (relTop >= h * 0.25 && relBottom <= h * 0.75) return;
                const targetCenter = relTop + tRect.height / 2;
                scrollEl.scrollBy({ top: targetCenter - h / 2, behavior: "smooth" });
            }

            function initConnectors() {
                connectorAbort?.abort();
                if (animFrame !== null) { cancelAnimationFrame(animFrame); animFrame = null; }
                connectorAbort = new AbortController();
                const { signal } = connectorAbort;

                const pathEl = document.getElementById("connector-path") as SVGPathElement | null;
                if (!pathEl) return;

                function drawLinePath(navEl: Element, gridEl: Element) {
                    const labelEl = navEl.querySelector(".project-grid-label");
                    const gRect = gridEl.getBoundingClientRect();
                    let xStart: number, x0: number, y0: number;
                    if (labelEl) {
                        const lRect = labelEl.getBoundingClientRect();
                        xStart = lRect.left;
                        x0 = lRect.right;
                        y0 = lRect.bottom + 2;
                    } else {
                        const nRect = navEl.getBoundingClientRect();
                        xStart = nRect.left;
                        x0 = nRect.right;
                        y0 = (nRect.top + nRect.bottom) / 2;
                    }
                    const x1 = gRect.left;
                    const y1 = (gRect.top + gRect.bottom) / 2;
                    const cp = Math.abs(x1 - x0) * 0.45;
                    pathEl!.setAttribute("d",
                        `M ${xStart} ${y0} L ${x0} ${y0} C ${x0 + cp} ${y0} ${x1 - cp} ${y1} ${x1} ${y1}`
                    );
                }

                function startLine(navEl: Element, gridEl: Element) {
                    if (animFrame !== null) cancelAnimationFrame(animFrame);
                    function frame() {
                        drawLinePath(navEl, gridEl);
                        pathEl!.classList.add("visible");
                        animFrame = requestAnimationFrame(frame);
                    }
                    animFrame = requestAnimationFrame(frame);
                }

                function stopLine() {
                    if (animFrame !== null) { cancelAnimationFrame(animFrame); animFrame = null; }
                    pathEl!.classList.remove("visible");
                }

                document.querySelectorAll<HTMLElement>(".home-masonry .project-grid-item[data-slug]").forEach((el) => {
                    const slug = el.dataset.slug!;
                    const navEl = document.querySelector<HTMLElement>(`.content-nav .project-grid-item[data-slug="${slug}"]`);
                    if (!navEl) return;
                    const navScroll = document.querySelector(".content-nav .col-scroll")!;
                    el.addEventListener("mouseenter", () => {
                        smartScroll(navScroll, navEl);
                        startLine(navEl, el);
                    }, { signal });
                    el.addEventListener("mouseleave", stopLine, { signal });
                });

                document.querySelectorAll<HTMLElement>(".content-nav .project-grid-item[data-slug]").forEach((el) => {
                    const slug = el.dataset.slug!;
                    const gridScroll = document.querySelector(".home-masonry-scroll");
                    el.addEventListener("mouseenter", () => {
                        const gridEl = document.querySelector<HTMLElement>(`.home-masonry .project-grid-item[data-slug="${slug}"]`);
                        if (!gridEl) return;
                        if (gridScroll) smartScroll(gridScroll, gridEl);
                        el.classList.add("peer-hovered-source");
                        gridEl.classList.add("peer-hovered");
                        startLine(el, gridEl);
                    }, { signal });
                    el.addEventListener("mouseleave", () => {
                        const gridEl = document.querySelector<HTMLElement>(`.home-masonry .project-grid-item[data-slug="${slug}"]`);
                        gridEl?.classList.remove("peer-hovered");
                        el.classList.remove("peer-hovered-source");
                        stopLine();
                    }, { signal });
                });
            }

            initConnectors();
            document.addEventListener("astro:after-swap", initConnectors);
        </script>
    </body>
</html>
