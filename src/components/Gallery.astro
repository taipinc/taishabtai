---
interface Props {
    caption?: string;
    alt?: string;
    gap?: string;
}

const { caption, alt, gap = "4px" } = Astro.props;
---

<div class="gallery" style={`--gallery-gap: ${gap}`}>
    <div class="gallery-images">
        <slot />
    </div>
    {(alt || caption) && <figcaption class="caption">{alt || caption}</figcaption>}
</div>
