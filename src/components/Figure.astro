---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: string;
    alt?: string;
    span?: number;
    refId?: string;
}

const { src, alt, span, refId } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}",
);

const imagePath = src.startsWith("/") ? src : `/src/assets/images/${src}`;
const imageImport = images[imagePath];

if (!imageImport) {
    throw new Error(`Image not found: ${imagePath}`);
}

const image = (await imageImport()).default;
const ar = image.width / image.height;
---

<figure style={`--ar: ${ar.toFixed(3)}${span ? `; grid-column: span ${span}` : ""}`} data-ref={refId || undefined}>
    <Image src={image} alt={alt || ""} />
    {alt && <figcaption class="caption">{alt}</figcaption>}
</figure>
