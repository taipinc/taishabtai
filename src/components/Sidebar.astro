---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const ongoing = (await getCollection("ongoing")).sort(
    (a, b) => b.data.year - a.data.year,
);
const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.year - a.data.year,
);
const otherWorks = (await getCollection("other-works")).sort(
    (a, b) => b.data.year - a.data.year,
);
const interactive = (await getCollection("interactive")).sort(
    (a, b) => b.data.year - a.data.year,
);
const teachingTools = (await getCollection("teaching-tools")).sort(
    (a, b) => b.data.year - a.data.year,
);

interface NavItem {
    title: string;
    slug: string;
    year: number;
    url?: string;
    github?: string;
    huggingface?: string;
}

interface NavSection {
    label: string;
    items: NavItem[];
    showYear: boolean;
    external: boolean;
}

const currentPath = Astro.url.pathname.replace(/\/$/, "");

// Merged grid items: all non-teaching-tools collections, sorted by year
interface GridItem {
    title: string;
    slug: string;
    year: number;
    hero?: ImageMetadata;
    url?: string;
    external: boolean;
}

const allGridItems: GridItem[] = [
    ...ongoing.map((p) => ({
        title: p.data.title,
        slug: p.data.slug,
        year: p.data.year,
        hero: p.data.hero,
        external: false,
    })),
    ...projects.map((p) => ({
        title: p.data.title,
        slug: p.data.slug,
        year: p.data.year,
        hero: p.data.hero,
        external: false,
    })),
    ...interactive.map((p) => ({
        title: p.data.title,
        slug: p.data.slug,
        year: p.data.year,
        hero: p.data.hero,
        external: false,
    })),
    ...otherWorks.map((p) => ({
        title: p.data.title,
        slug: p.data.slug,
        year: p.data.year,
        hero: p.data.hero,
        external: false,
    })),
].sort((a, b) => b.year - a.year);

const gridTeachingTools: GridItem[] = teachingTools.map((p) => ({
    title: p.data.title,
    slug: p.data.slug,
    year: p.data.year,
    hero: p.data.hero,
    url: p.data.url,
    external: true,
}));

const sections: NavSection[] = [
    {
        label: "Ongoing",
        showYear: true,
        external: false,
        items: ongoing.map((p) => ({
            title: p.data.title,
            slug: p.data.slug,
            year: p.data.year,
        })),
    },
    {
        label: "Selected Works",
        showYear: true,
        external: false,
        items: projects.map((p) => ({
            title: p.data.title,
            slug: p.data.slug,
            year: p.data.year,
        })),
    },
    {
        label: "Interactive",
        showYear: false,
        external: false,
        items: interactive.map((p) => ({
            title: p.data.title,
            slug: p.data.slug,
            year: p.data.year,
        })),
    },
    {
        label: "Other Works",
        showYear: false,
        external: false,
        items: otherWorks.map((p) => ({
            title: p.data.title,
            slug: p.data.slug,
            year: p.data.year,
        })),
    },
    {
        label: "Teaching Tools",
        showYear: false,
        external: true,
        items: teachingTools.map((p) => ({
            title: p.data.title,
            slug: p.data.slug,
            year: p.data.year,
            hero: p.data.hero,
            url: p.data.url,
            github: p.data.github,
            huggingface: p.data.huggingface,
        })),
    },
];
---

<nav class="sidebar-nav">
    <div class="sidebar-top-row">
        <div class="artist-name">
            <a href="/">Shabtai Pinchevsky</a>
        </div>
        <button
            class="view-toggle"
            id="viewToggle"
            aria-label="Toggle grid view"
        >
            <svg
                class="icon-grid"
                viewBox="0 0 16 16"
                width="1em"
                height="1em"
                fill="currentColor"
            >
                <rect x="1" y="1" width="6" height="6"></rect><rect
                    x="9"
                    y="1"
                    width="6"
                    height="6"></rect>
                <rect x="1" y="9" width="6" height="6"></rect><rect
                    x="9"
                    y="9"
                    width="6"
                    height="6"></rect>
            </svg>
            <svg
                class="icon-list"
                viewBox="0 0 16 16"
                width="1em"
                height="1em"
                fill="currentColor"
                style="display:none"
            >
                <rect x="1" y="2" width="14" height="2"></rect><rect
                    x="1"
                    y="7"
                    width="14"
                    height="2"></rect>
                <rect x="1" y="12" width="14" height="2"></rect>
            </svg>
        </button>
    </div>

    <section id="about" class="about-section">
        <p>
            I'm a photographer and digital media artist whose practice examines
            the politics of image-making in contested geographies, particularly
            Israel/Palestine. I work across 3D modeling, mapping, drone
            photography, and archival research to examine photography's
            entanglements with colonial and territorial politics. I'm an
            Assistant Professor of Photography at Parsons School of Design, The
            New School.
        </p>
    </section>

    <div class="sidebar-list-view" id="listView">
        {
            sections.map(
                (section) =>
                    section.items.length > 0 && (
                        <div class="nav-section">
                            <h2 class="nav-heading">{section.label}</h2>
                            <ul>
                                {section.items.map((item) =>
                                    section.external ? (
                                        <li>
                                            <div class="nav-tool-row">
                                                <a
                                                    href={item.url || "#"}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="nav-tool-link"
                                                >
                                                    <span class="nav-title">
                                                        {item.title}
                                                    </span>
                                                    <span class="external-arrow">
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            viewBox="0 0 12 12"
                                                            width="1em"
                                                            height="1em"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        >
                                                            <path d="M3.5 1.5h7v7M10.5 1.5L1.5 10.5" />
                                                        </svg>
                                                    </span>
                                                </a>
                                                {item.github && (
                                                    <a
                                                        href={item.github}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="github-link"
                                                        aria-label={`${item.title} on GitHub`}
                                                    >
                                                        <svg
                                                            viewBox="0 0 24 24"
                                                            width="1em"
                                                            height="1em"
                                                            fill="currentColor"
                                                        >
                                                            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                                                        </svg>
                                                    </a>
                                                )}
                                                {item.huggingface && (
                                                    <a
                                                        href={item.huggingface}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="github-link"
                                                        aria-label={`${item.title} on Hugging Face`}
                                                    >
                                                        <svg
                                                            viewBox="0 0 24 24"
                                                            width="1em"
                                                            height="1em"
                                                            fill="currentColor"
                                                        >
                                                            <path d="M12.025 1.13c-5.77 0-10.449 4.647-10.449 10.378 0 1.112.178 2.181.503 3.185.064-.222.203-.444.416-.577a.96.96 0 0 1 .524-.15c.293 0 .584.124.84.284.278.173.48.408.71.694.226.282.458.611.684.951v-.014c.017-.324.106-.622.264-.874s.403-.487.762-.543c.3-.047.596.06.787.203s.31.313.4.467c.15.257.212.468.233.542.01.026.653 1.552 1.657 2.54.616.605 1.01 1.223 1.082 1.912.055.537-.096 1.059-.38 1.572.637.121 1.294.187 1.967.187.657 0 1.298-.063 1.921-.178-.287-.517-.44-1.041-.384-1.581.07-.69.465-1.307 1.081-1.913 1.004-.987 1.647-2.513 1.657-2.539.021-.074.083-.285.233-.542.09-.154.208-.323.4-.467a1.08 1.08 0 0 1 .787-.203c.359.056.604.29.762.543s.247.55.265.874v.015c.225-.34.457-.67.683-.952.23-.286.432-.52.71-.694.257-.16.547-.284.84-.285a.97.97 0 0 1 .524.151c.228.143.373.388.43.625l.006.04a10.3 10.3 0 0 0 .534-3.273c0-5.731-4.678-10.378-10.449-10.378M8.327 6.583a1.5 1.5 0 0 1 .713.174 1.487 1.487 0 0 1 .617 2.013c-.183.343-.762-.214-1.102-.094-.38.134-.532.914-.917.71a1.487 1.487 0 0 1 .69-2.803m7.486 0a1.487 1.487 0 0 1 .689 2.803c-.385.204-.536-.576-.916-.71-.34-.12-.92.437-1.103.094a1.487 1.487 0 0 1 .617-2.013 1.5 1.5 0 0 1 .713-.174m-10.68 1.55a.96.96 0 1 1 0 1.921.96.96 0 0 1 0-1.92m13.838 0a.96.96 0 1 1 0 1.92.96.96 0 0 1 0-1.92M8.489 11.458c.588.01 1.965 1.157 3.572 1.164 1.607-.007 2.984-1.155 3.572-1.164.196-.003.305.12.305.454 0 .886-.424 2.328-1.563 3.202-.22-.756-1.396-1.366-1.63-1.32q-.011.001-.02.006l-.044.026-.01.008-.03.024q-.018.017-.035.036l-.032.04a1 1 0 0 0-.058.09l-.014.025q-.049.088-.11.19a1 1 0 0 1-.083.116 1.2 1.2 0 0 1-.173.18q-.035.029-.075.058a1.3 1.3 0 0 1-.251-.243 1 1 0 0 1-.076-.107c-.124-.193-.177-.363-.337-.444-.034-.016-.104-.008-.2.022q-.094.03-.216.087-.06.028-.125.063l-.13.074q-.067.04-.136.086a3 3 0 0 0-.135.096 3 3 0 0 0-.26.219 2 2 0 0 0-.12.121 2 2 0 0 0-.106.128l-.002.002a2 2 0 0 0-.09.132l-.001.001a1.2 1.2 0 0 0-.105.212q-.013.036-.024.073c-1.139-.875-1.563-2.317-1.563-3.203 0-.334.109-.457.305-.454m.836 10.354c.824-1.19.766-2.082-.365-3.194-1.13-1.112-1.789-2.738-1.789-2.738s-.246-.945-.806-.858-.97 1.499.202 2.362c1.173.864-.233 1.45-.685.64-.45-.812-1.683-2.896-2.322-3.295s-1.089-.175-.938.647 2.822 2.813 2.562 3.244-1.176-.506-1.176-.506-2.866-2.567-3.49-1.898.473 1.23 2.037 2.16c1.564.932 1.686 1.178 1.464 1.53s-3.675-2.511-4-1.297c-.323 1.214 3.524 1.567 3.287 2.405-.238.839-2.71-1.587-3.216-.642-.506.946 3.49 2.056 3.522 2.064 1.29.33 4.568 1.028 5.713-.624m5.349 0c-.824-1.19-.766-2.082.365-3.194 1.13-1.112 1.789-2.738 1.789-2.738s.246-.945.806-.858.97 1.499-.202 2.362c-1.173.864.233 1.45.685.64.451-.812 1.683-2.896 2.322-3.295s1.089-.175.938.647-2.822 2.813-2.562 3.244 1.176-.506 1.176-.506 2.866-2.567 3.49-1.898-.473 1.23-2.037 2.16c-1.564.932-1.686 1.178-1.464 1.53s3.675-2.511 4-1.297c.323 1.214-3.524 1.567-3.287 2.405.238.839 2.71-1.587 3.216-.642.506.946-3.49 2.056-3.522 2.064-1.29.33-4.568 1.028-5.713-.624" />
                                                        </svg>
                                                    </a>
                                                )}
                                            </div>
                                        </li>
                                    ) : (
                                        <li>
                                            <a
                                                href={`/${item.slug}`}
                                                class:list={[
                                                    {
                                                        active:
                                                            currentPath ===
                                                            `/${item.slug}`,
                                                    },
                                                ]}
                                            >
                                                <span class="nav-title">
                                                    {item.title}
                                                </span>
                                                {section.showYear && (
                                                    <span class="year">
                                                        {item.year}
                                                    </span>
                                                )}
                                            </a>
                                        </li>
                                    ),
                                )}
                            </ul>
                        </div>
                    ),
            )
        }
    </div>

    <div class="sidebar-grid-view" id="gridView">
        <div class="grid-container">
            {
                allGridItems.map((item) => (
                    <a
                        href={`/${item.slug}`}
                        class:list={[
                            "grid-item",
                            { active: currentPath === `/${item.slug}` },
                        ]}
                    >
                        {item.hero ? (
                            <Image
                                src={item.hero}
                                alt={item.title}
                                class="grid-thumb"
                                loading="lazy"
                                width={800}
                                quality={80}
                            />
                        ) : (
                            <div class="grid-placeholder" />
                        )}
                        <span class="grid-title">{item.title}</span>
                    </a>
                ))
            }
        </div>
        {
            gridTeachingTools.length > 0 && (
                <div class="nav-section">
                    <h2 class="nav-heading">Teaching Tools</h2>
                    <div class="grid-container">
                        {gridTeachingTools.map((item) => (
                            <a
                                href={item.url || "#"}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="grid-item"
                            >
                                {item.hero ? (
                                    <Image
                                        src={item.hero}
                                        alt={item.title}
                                        class="grid-thumb"
                                        loading="lazy"
                                        widths={[200, 400]}
                                    />
                                ) : (
                                    <div class="grid-placeholder" />
                                )}
                                <span class="grid-title">{item.title}</span>
                            </a>
                        ))}
                    </div>
                </div>
            )
        }
    </div>
</nav>

<script>
    document.getElementById("viewToggle")!.addEventListener("click", () => {
        const isGrid = document.documentElement.classList.toggle("grid-mode");
        localStorage.setItem("sidebar-view", isGrid ? "grid" : "list");
    });
</script>
