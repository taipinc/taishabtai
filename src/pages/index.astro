---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const allPosts = (await getCollection("posts"))
    .filter(p => p.data.slug && p.data.type !== "text")
    .sort((a, b) => b.data.year - a.data.year);

const groups = [
    { label: "Ongoing", types: ["ongoing"] },
    { label: "Selected", types: ["project"] },
    { label: "Interactive", types: ["interactive"] },
    { label: "Other Works", types: ["other-work"] },
    { label: "Teaching Tools", types: ["teaching-tool"] },
].map(g => ({
    label: g.label,
    items: allPosts.filter(p => g.types.includes(p.data.type)),
})).filter(g => g.items.length > 0);
---

<SiteLayout>
    <div slot="center-header" class="works-view-toggle">
        <button class="works-view-btn" data-view="list">list</button>
        <span class="works-view-sep">/</span>
        <button class="works-view-btn" data-view="grid">grid</button>
    </div>

    <div class="home-works-container" data-view="list">
        <div class="home-works list-view-content">
            {groups.map((group, i) => (
                <>
                    {i > 0 && <hr class="group-hr" />}
                    <ul class="work-list">
                        {group.items.map((item, j) => (
                            <li>
                                {j === 0 && <span class="group-label">{group.label}</span>}
                                <a href={`${base}/${item.data.slug}`}>{item.data.title}</a>
                            </li>
                        ))}
                    </ul>
                </>
            ))}
        </div>

        <div class="home-works-grid grid-view-content">
            {groups.map((group) => (
                group.items.map((item, j) => (
                    <a href={`${base}/${item.data.slug}`} class="works-grid-item">
                        {j === 0 && <div class="works-grid-group-name">{group.label}</div>}
                        <div class="works-grid-thumb">
                            {item.data.hero ? (
                                <Image
                                    src={item.data.hero}
                                    alt={item.data.title}
                                    width={300}
                                    height={400}
                                    loading="lazy"
                                />
                            ) : (
                                <div class="works-grid-placeholder" />
                            )}
                        </div>
                        <div class="works-grid-title">{item.data.title}</div>
                    </a>
                ))
            ))}
        </div>
    </div>

    <script>
        function initWorksViewToggle() {
            const btns = document.querySelectorAll<HTMLButtonElement>('.works-view-btn');
            const container = document.querySelector<HTMLElement>('.home-works-container');
            if (!btns.length || !container) return;

            function setView(view: string) {
                container!.dataset.view = view;
                btns.forEach(b => b.classList.toggle('active', b.dataset.view === view));
            }

            const saved = localStorage.getItem('works-view') || 'list';
            setView(saved);

            btns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const view = btn.dataset.view!;
                    setView(view);
                    localStorage.setItem('works-view', view);
                });
            });
        }

        initWorksViewToggle();
        document.addEventListener('astro:after-swap', initWorksViewToggle);
    </script>
</SiteLayout>
