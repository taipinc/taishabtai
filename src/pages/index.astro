---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import GridContentLayout from "../layouts/GridContentLayout.astro";
import { recentItems } from "../data/recent";

interface GridItem {
    title: string;
    slug: string;
    year: number;
    hero?: ImageMetadata;
    url?: string;
    external: boolean;
    summary?: string;
}

const interactive = (await getCollection("interactive")).sort(
    (a, b) => b.data.year - a.data.year,
);
const otherWorks = (await getCollection("other-works")).sort(
    (a, b) => b.data.year - a.data.year,
);
const teachingTools = (await getCollection("teaching-tools")).sort(
    (a, b) => b.data.year - a.data.year,
);

const toGridItems = (items: any[], external = false): GridItem[] =>
    items.map((p) => ({
        title: p.data.title,
        slug: p.data.slug,
        year: p.data.year,
        hero: p.data.hero,
        url: p.data.url,
        external,
        summary: p.data.summary,
    }));

function getEmbedUrl(url: string): string {
    const vimeoMatch = url.match(/vimeo\.com\/(\d+)/);
    if (vimeoMatch) return `https://player.vimeo.com/video/${vimeoMatch[1]}`;
    const youtubeMatch = url.match(
        /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/,
    );
    if (youtubeMatch) return `https://www.youtube.com/embed/${youtubeMatch[1]}`;
    return url;
}

function getVimeoThumb(url: string): string | null {
    const match = url.match(/vimeo\.com\/(\d+)/);
    return match ? `https://vumbnail.com/${match[1]}.jpg` : null;
}

// Resolve thumbnail images from src/assets/recent/
const recentImages = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/recent/*.{jpg,jpeg,png,webp,gif}",
);

const resolvedRecent = await Promise.all(
    recentItems.map(async (item) => {
        let thumbImage: ImageMetadata | undefined;
        let srcImage: ImageMetadata | undefined;

        if (item.thumb) {
            const key = `../assets/recent/${item.thumb}`;
            if (recentImages[key]) {
                thumbImage = (await recentImages[key]()).default;
            }
        }
        if (item.src) {
            const key = `../assets/recent/${item.src}`;
            if (recentImages[key]) {
                srcImage = (await recentImages[key]()).default;
            }
        }

        return { ...item, thumbImage, srcImage };
    }),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const otherWorksItems = toGridItems(otherWorks);
const interactiveItems = toGridItems(interactive);
const teachingToolItems = toGridItems(teachingTools, true);
---

<GridContentLayout>
    <div class="home-content">
        <div class="col-header"></div>
        <div class="home-columns">
            <!-- Column 2: Other Works -->
            <div class="project-grid-col">
                <div class="col-scroll">
                    <h2 class="col-heading">Other Works</h2>
                    {
                        otherWorksItems.map((item) => (
                            <a
                                href={`${base}/${item.slug}`}
                                class="project-grid-item"
                            >
                                {item.hero ? (
                                    <div class="img-tint">
                                        <Image
                                            src={item.hero}
                                            alt={item.title}
                                            loading="lazy"
                                            width={800}
                                            quality={80}
                                        />
                                    </div>
                                ) : (
                                    <div class="grid-placeholder" />
                                )}
                                <div class="project-grid-label">
                                    {item.title}
                                </div>
                                {item.summary && <div class="project-grid-summary">{item.summary}</div>}
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Column 3: Interactive / Teaching Tools -->
            <div class="project-grid-col">
                <div class="col-scroll">
                    <h2 class="col-heading">Interactive</h2>
                    {
                        interactiveItems.map((item) => (
                            <a
                                href={`${base}/${item.slug}`}
                                class="project-grid-item"
                            >
                                {item.hero ? (
                                    <div class="img-tint">
                                        <Image
                                            src={item.hero}
                                            alt={item.title}
                                            loading="lazy"
                                            width={800}
                                            quality={80}
                                        />
                                    </div>
                                ) : (
                                    <div class="grid-placeholder" />
                                )}
                                <div class="project-grid-label">
                                    {item.title}
                                </div>
                                {item.summary && <div class="project-grid-summary">{item.summary}</div>}
                            </a>
                        ))
                    }

                    <h2 class="col-heading">Teaching Tools</h2>
                    {
                        teachingToolItems.map((item) => (
                            <a
                                href={item.url || "#"}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-grid-item"
                            >
                                {item.hero ? (
                                    <div class="img-tint">
                                        <Image
                                            src={item.hero}
                                            alt={item.title}
                                            loading="lazy"
                                            width={800}
                                            quality={80}
                                        />
                                        <div class="external-link-icon">
                                            &#8599;
                                        </div>
                                    </div>
                                ) : (
                                    <div class="grid-placeholder" />
                                )}
                                <div class="project-grid-label">
                                    {item.title}
                                </div>
                                {item.summary && <div class="project-grid-summary">{item.summary}</div>}
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Column 4: Info / Recent -->
            <div class="project-grid-col">
                <div class="col-scroll">
                    <h2 class="col-heading">Info</h2>
                    <div class="info-section">
                        <p>
                            I'm a photographer and digital media artist whose
                            practice examines the politics of image-making in
                            contested geographies, particularly
                            Israel/Palestine. I work across 3D modeling,
                            mapping, drone photography, and archival research to
                            examine photography's entanglements with colonial
                            and territorial politics.
                        </p><p>
                            I'm an Assistant Professor of Photography at Parsons
                            School of Design, The New School.
                        </p>
                    </div>

                    <h2 class="col-heading">Recent</h2>
                    {
                        resolvedRecent.map((item, i) =>
                            item.srcImage ? (
                                <button
                                    class="recent-media"
                                    data-index={i}
                                    data-type="image"
                                    data-src={item.srcImage.src}
                                    data-caption={item.caption || ""}
                                >
                                    <div class="img-tint">
                                        <Image
                                            src={item.srcImage}
                                            alt={item.caption || ""}
                                            loading="lazy"
                                            width={800}
                                            quality={80}
                                        />
                                    </div>
                                </button>
                            ) : item.video ? (
                                <button
                                    class="recent-media"
                                    data-index={i}
                                    data-type="video"
                                    data-src={getEmbedUrl(item.video)}
                                    data-caption={item.caption || ""}
                                >
                                    <div class="img-tint">
                                        {item.thumbImage ? (
                                            <Image
                                                src={item.thumbImage}
                                                alt={item.caption || ""}
                                                loading="lazy"
                                                width={800}
                                                quality={80}
                                            />
                                        ) : getVimeoThumb(item.video) ? (
                                            <img
                                                src={getVimeoThumb(item.video)!}
                                                alt={item.caption || ""}
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="grid-placeholder" />
                                        )}
                                        <div class="video-play-icon">
                                            &#9654;
                                        </div>
                                    </div>
                                </button>
                            ) : null,
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</GridContentLayout>
