---
import GridContentLayout from "../layouts/GridContentLayout.astro";
import { getImage } from "astro:assets";
import mainImgFile from "../assets/images/main.jpg";

const mainImgSrc = (await getImage({ src: mainImgFile, quality: 90 })).src;
---

<GridContentLayout>
    <div class="home-content">
        <img id="home-display-img" src={mainImgSrc} data-default-src={mainImgSrc} alt="" />
        <div id="home-display-label">
            <div class="home-display-title"></div>
            <div class="home-display-summary"></div>
        </div>
        <div id="home-bio-overlay">
            <p>I'm a photographer and digital media artist whose practice examines the politics of image-making in contested geographies, particularly Israel/Palestine. I work across 3D modeling, mapping, drone photography, and archival research to examine photography's entanglements with colonial and territorial politics.</p>
            <p>I'm an Assistant Professor of Photography at Parsons School of Design, The New School.</p>
        </div>
    </div>
</GridContentLayout>
