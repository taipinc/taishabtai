---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const allPosts = (await getCollection("posts"))
    .filter(p => p.data.slug && p.data.type !== "text")
    .sort((a, b) => b.data.year - a.data.year);

const groups = [
    { label: "Works", types: ["ongoing", "project"] },
    { label: "Interactive", types: ["interactive"] },
    { label: "Other Works", types: ["other-work"] },
    { label: "Teaching Tools", types: ["teaching-tool"] },
].map(g => ({
    label: g.label,
    items: allPosts.filter(p => g.types.includes(p.data.type)),
})).filter(g => g.items.length > 0);
---

<SiteLayout>
    <div class="home-works">
        {groups.map((group, i) => (
            <>
                {i > 0 && <hr class="group-hr" />}
                <ul class="work-list">
                    {group.items.map(item => (
                        <li>
                            <a href={`${base}/${item.data.slug}`}>{item.data.title}</a>
                        </li>
                    ))}
                </ul>
            </>
        ))}
    </div>
</SiteLayout>
