---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import GridContentLayout from "../layouts/GridContentLayout.astro";

function getEmbedUrl(url: string): string {
    const vimeoMatch = url.match(/vimeo\.com\/(\d+)/);
    if (vimeoMatch) return `https://player.vimeo.com/video/${vimeoMatch[1]}`;
    const youtubeMatch = url.match(
        /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/,
    );
    if (youtubeMatch) return `https://www.youtube.com/embed/${youtubeMatch[1]}`;
    return url;
}

function getVimeoThumb(url: string): string | null {
    const match = url.match(/vimeo\.com\/(\d+)/);
    return match ? `https://vumbnail.com/${match[1]}.jpg` : null;
}

const allPosts = (await getCollection("posts")).sort(
    (a, b) => b.data.year - a.data.year,
);

// Resolve video thumbnails
const recentImages = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/recent/*.{jpg,jpeg,png,webp,gif}",
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<GridContentLayout>
    <div class="home-content">
        <div class="col-header"></div>
        <div class="home-masonry-scroll">
            <div class="home-masonry">
                {
                    await Promise.all(
                        allPosts.map(async (post) => {
                            const {
                                type,
                                title,
                                slug,
                                hero,
                                summary,
                                videoUrl,
                                thumb,
                                caption,
                                background,
                            } = post.data;
                            if (type === "video") {
                                let thumbImg: ImageMetadata | undefined;
                                if (thumb) {
                                    const key = `../assets/recent/${thumb}`;
                                    if (recentImages[key])
                                        thumbImg = (await recentImages[key]())
                                            .default;
                                }
                                const embedUrl = videoUrl
                                    ? getEmbedUrl(videoUrl)
                                    : "";
                                const autoThumbUrl =
                                    videoUrl && !thumbImg
                                        ? (getVimeoThumb(videoUrl) ?? undefined)
                                        : undefined;
                                return (
                                    <button
                                        class="project-grid-item recent-media"
                                        data-type="video"
                                        data-src={embedUrl}
                                        data-caption={caption ?? ""}
                                    >
                                        <div class="img-tint">
                                            {thumbImg ? (
                                                <Image
                                                    src={thumbImg}
                                                    alt={caption ?? title}
                                                    loading="lazy"
                                                    width={800}
                                                    quality={80}
                                                />
                                            ) : autoThumbUrl ? (
                                                <img
                                                    src={autoThumbUrl}
                                                    alt={caption ?? title}
                                                    loading="lazy"
                                                />
                                            ) : (
                                                <div class="grid-placeholder" />
                                            )}
                                            <div class="video-play-icon">
                                                &#9654;
                                            </div>
                                        </div>
                                        {caption && (
                                            <div class="project-grid-label">
                                                {caption}
                                            </div>
                                        )}
                                    </button>
                                );
                            }

                            if (type === "text") {
                                return (
                                    <a
                                        href={
                                            slug ? `${base}/${slug}` : undefined
                                        }
                                        class="project-grid-item project-grid-item--text"
                                        data-type="text"
                                        style={background ? `background: ${background}` : undefined}
                                    >
                                        <div class="project-grid-label">
                                            {title}
                                        </div>
                                        {summary && (
                                            <div class="project-grid-summary">
                                                {summary}
                                            </div>
                                        )}
                                    </a>
                                );
                            }

                            return (
                                <a
                                    href={slug ? `${base}/${slug}` : undefined}
                                    class="project-grid-item"
                                    data-type={type}
                                    data-slug={slug}
                                >
                                    {hero && (
                                        <div class="img-tint">
                                            <Image
                                                src={hero}
                                                alt={title}
                                                loading="lazy"
                                                width={800}
                                                quality={80}
                                            />
                                        </div>
                                    )}
                                    <div class="project-grid-label">
                                        {title}
                                    </div>
                                    {summary && (
                                        <div class="project-grid-summary">
                                            {summary}
                                        </div>
                                    )}
                                </a>
                            );
                        }),
                    )
                }
            </div>
        </div>
    </div>
</GridContentLayout>
