---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import GridContentLayout from "../layouts/GridContentLayout.astro";
import { recentItems } from "../data/recent";

interface WorkItem {
    kind: "work";
    title: string;
    slug: string;
    year: number;
    hero?: ImageMetadata;
    url?: string;
    external: boolean;
    summary?: string;
}

interface MediaItem {
    kind: "media";
    year: number;
    type: "video" | "image";
    src: string;
    caption: string;
    thumb?: ImageMetadata;
    thumbUrl?: string;
}

type GridItem = WorkItem | MediaItem;

function getEmbedUrl(url: string): string {
    const vimeoMatch = url.match(/vimeo\.com\/(\d+)/);
    if (vimeoMatch) return `https://player.vimeo.com/video/${vimeoMatch[1]}`;
    const youtubeMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/);
    if (youtubeMatch) return `https://www.youtube.com/embed/${youtubeMatch[1]}`;
    return url;
}

function getVimeoThumb(url: string): string | null {
    const match = url.match(/vimeo\.com\/(\d+)/);
    return match ? `https://vumbnail.com/${match[1]}.jpg` : null;
}

const ongoing      = (await getCollection("ongoing")).sort((a, b) => b.data.year - a.data.year);
const projects     = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
const interactive  = (await getCollection("interactive")).sort((a, b) => b.data.year - a.data.year);
const otherWorks   = (await getCollection("other-works")).sort((a, b) => b.data.year - a.data.year);
const teachingTools = (await getCollection("teaching-tools")).sort((a, b) => b.data.year - a.data.year);

const toWorkItems = (items: any[], external = false): WorkItem[] =>
    items.map((p) => ({
        kind: "work",
        title: p.data.title,
        slug: p.data.slug,
        year: p.data.year,
        hero: p.data.hero,
        url: p.data.url,
        external,
        summary: p.data.summary,
    }));

// Resolve recent media thumbnails
const recentImages = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/recent/*.{jpg,jpeg,png,webp,gif}",
);

const recentMediaItems: MediaItem[] = await Promise.all(
    recentItems.map(async (item) => {
        let thumb: ImageMetadata | undefined;
        if (item.thumb) {
            const key = `../assets/recent/${item.thumb}`;
            if (recentImages[key]) thumb = (await recentImages[key]()).default;
        }
        if (item.video) {
            return {
                kind: "media",
                year: item.year ?? 2025,
                type: "video",
                src: getEmbedUrl(item.video),
                caption: item.caption ?? "",
                thumb,
                thumbUrl: !thumb ? (getVimeoThumb(item.video) ?? undefined) : undefined,
            } satisfies MediaItem;
        }
        const srcKey = item.src ? `../assets/recent/${item.src}` : null;
        const srcImage = srcKey && recentImages[srcKey] ? (await recentImages[srcKey]()).default : undefined;
        return {
            kind: "media",
            year: item.year ?? 2025,
            type: "image",
            src: srcImage?.src ?? "",
            caption: item.caption ?? "",
            thumb: srcImage,
        } satisfies MediaItem;
    })
);

const allItems: GridItem[] = [
    ...toWorkItems(ongoing),
    ...toWorkItems(projects),
    ...toWorkItems(interactive),
    ...toWorkItems(otherWorks),
    ...toWorkItems(teachingTools),
    ...recentMediaItems,
].sort((a, b) => b.year - a.year);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<GridContentLayout>
    <div class="home-content">
        <div class="col-header"></div>
        <div class="home-masonry-scroll">
            <div class="home-masonry">
                {allItems.map((item) => {
                    if (item.kind === "media") {
                        return (
                            <button
                                class="project-grid-item recent-media"
                                data-type={item.type}
                                data-src={item.src}
                                data-caption={item.caption}
                            >
                                <div class="img-tint">
                                    {item.thumb ? (
                                        <Image src={item.thumb} alt={item.caption} loading="lazy" width={800} quality={80} />
                                    ) : item.thumbUrl ? (
                                        <img src={item.thumbUrl} alt={item.caption} loading="lazy" />
                                    ) : (
                                        <div class="grid-placeholder" />
                                    )}
                                    {item.type === "video" && <div class="video-play-icon">&#9654;</div>}
                                </div>
                                {item.caption && <div class="project-grid-label">{item.caption}</div>}
                            </button>
                        );
                    }
                    if (item.external) {
                        return (
                            <a
                                href={item.url || "#"}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-grid-item"
                            >
                                {item.hero ? (
                                    <div class="img-tint">
                                        <Image src={item.hero} alt={item.title} loading="lazy" width={800} quality={80} />
                                        <div class="external-link-icon">&#8599;</div>
                                    </div>
                                ) : (
                                    <div class="grid-placeholder" />
                                )}
                                <div class="project-grid-label">{item.title}</div>
                                {item.summary && <div class="project-grid-summary">{item.summary}</div>}
                            </a>
                        );
                    }
                    return (
                        <a href={`${base}/${item.slug}`} class="project-grid-item">
                            {item.hero ? (
                                <div class="img-tint">
                                    <Image src={item.hero} alt={item.title} loading="lazy" width={800} quality={80} />
                                </div>
                            ) : (
                                <div class="grid-placeholder" />
                            )}
                            <div class="project-grid-label">{item.title}</div>
                            {item.summary && <div class="project-grid-summary">{item.summary}</div>}
                        </a>
                    );
                })}
            </div>
        </div>
    </div>
</GridContentLayout>
