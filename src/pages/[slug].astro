---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import GridContentLayout from "../layouts/GridContentLayout.astro";

export async function getStaticPaths() {
    const collections = ["ongoing", "projects", "interactive", "other-works"] as const;
    const allItems = (
        await Promise.all(collections.map((c) => getCollection(c)))
    ).flat();

    return allItems.map((item) => ({
        params: { slug: item.data.slug },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { slug, title, year, medium, hero, iframe } = item.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<GridContentLayout
    title={`${title} — Shabtai Pinchevsky`}
    activeSlug={slug}
>
    <div class="content-page">
        <header class="project-header">
            <div class="project-header-text">
                <h2>{title}</h2>
                <p class="meta">{year}{medium && <><br />{medium}</>}</p>
            </div>
            <a href={`${base}/`} class="close-btn" aria-label="Close">&times;</a>
        </header>
        {iframe ? (
            <div class="project-body iframe-section">
                <iframe class="project-iframe" src={iframe} title={title}></iframe>
            </div>
        ) : (
            <div class="project-body">
                {hero && <Image src={hero} alt={title} class="project-hero" />}
                <div class="project-content" data-slug={slug}>
                    <Content />
                </div>
            </div>
        )}
    </div>
</GridContentLayout>
