---
import { getCollection, render } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import FeedBlock from "../components/FeedBlock.astro";
import NullBlock from "../components/NullBlock.astro";

export async function getStaticPaths() {
    const allPosts = await getCollection("posts");
    return allPosts
        .filter((item) => item.data.slug)
        .map((item) => ({
            params: { slug: item.data.slug },
            props: { item },
        }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { slug, title, year, medium, iframe, background, dark, type } = item.data;
const isRecent = type === "recent";
const fullPageComponents = isRecent
    ? { Summary: NullBlock, Full: FeedBlock }
    : {};
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout
    title={`${title} — Shabtai Pinchevsky`}
    background={background}
    dark={dark}
    centerIframe={!isRecent && !!iframe}
    activeSlug={slug}
    isRecent={isRecent}
    isWide={!!iframe}
>
    {
        isRecent || iframe ? (
            <Fragment slot="center-header">
                <div class="project-header-text">
                    <h2>{title}</h2>
                </div>
                <a href={`${base}/`} class="close-btn" aria-label="Close">
                    &times;
                </a>
            </Fragment>
        ) : (
            <Fragment slot="center-header">
                <div class="project-header-text">
                    <h2>{title}</h2>
                </div>
                <a href={`${base}/`} class="close-btn" aria-label="Close">
                    &times;
                </a>
            </Fragment>
        )
    }

    {
        !isRecent && !iframe && (
            <Fragment slot="right-header">
                <p class="meta">
                    {year}
                    {medium && <> · {medium}</>}
                </p>
                <!-- <a href={`${base}/`} class="close-btn" aria-label="Close">
                    &times;
                </a> -->
            </Fragment>
        )
    }

    {
        !isRecent && iframe ? (
            <iframe class="project-iframe" src={iframe} title={title} />
        ) : (
            <div class="project-body">
                <div class="project-content" data-slug={slug}>
                    <Content components={fullPageComponents} />
                </div>
            </div>
        )
    }
</SiteLayout>
