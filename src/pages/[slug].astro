---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LazySection from "../components/LazySection.astro";

export async function getStaticPaths() {
    const collections = ["ongoing", "projects", "interactive", "other-works"] as const;
    const allItems = (
        await Promise.all(collections.map((c) => getCollection(c)))
    ).flat();

    return allItems.map((item) => ({
        params: { slug: item.data.slug },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={`${item.data.title} — Shabtai Pinchevsky`}>
    <LazySection
        slug={item.data.slug}
        title={item.data.title}
        year={item.data.year}
        medium={item.data.medium}
        iframe={item.data.iframe}
    >
        <Content />
    </LazySection>
</BaseLayout>
