---
import { getCollection, render } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

export async function getStaticPaths() {
    const allPosts = await getCollection("posts");
    return allPosts
        .filter((item) => item.data.slug)
        .map((item) => ({
            params: { slug: item.data.slug },
            props: { item },
        }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { slug, title, year, medium, iframe, background } = item.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout
    title={`${title} — Shabtai Pinchevsky`}
    background={background}
    centerIframe={!!iframe}
    activeSlug={slug}
    isWide={!!iframe}
>
    <div class="project-header-text" slot="center-header">
        <h2>{title}</h2>
        <p class="meta">{year}{medium && <><br />{medium}</>}</p>
    </div>
    {iframe
        ? <a href={`${base}/`} class="close-btn" slot="center-header" aria-label="Close">&times;</a>
        : <a href={`${base}/`} class="close-btn" slot="right-header" aria-label="Close">&times;</a>
    }

    {iframe ? (
        <iframe class="project-iframe" src={iframe} title={title}></iframe>
    ) : (
        <div class="project-body">
            <div class="project-content" data-slug={slug}>
                <Content />
            </div>
        </div>
    )}
</SiteLayout>
